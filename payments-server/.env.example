PORT=8080
PUBLIC_BASE_URL=https://api.seudominio.com
FIREBASE_DATABASE_URL=https://SEU-PROJETO-default-rtdb.firebaseio.com
ANDROID_PACKAGE_NAME=com.solo.fitness
MERCADO_PAGO_ACCESS_TOKEN=COLOQUE_O_ACCESS_TOKEN_PRIVADO_AQUI
MERCADO_PAGO_WEBHOOK_SECRET=COLOQUE_A_ASSINATURA_SECRETA_DO_WEBHOOK

# Use UMA opção para Firebase/Google Play:
# 1) arquivo montado pelo provedor:
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/service-account.json
# 2) ou JSON em uma variável secreta:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
